
@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #111210;
  --surface: #1b1c19;
  --surface-light: #242520;
  --text: #f3f1eb;
  --muted: #96968d;
  --accent: #e58a52;
  --border: rgba(255,255,255,.11);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Manrope', sans-serif;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

.header {
  position: absolute;
  z-index: 10;
  top: 0;
  left: 0;
  width: 100%;
  padding: 28px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255,255,255,.15);
}

.logo {
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -1px;
}

.logo span {
  font-weight: 400;
}

.logo i {
  color: var(--accent);
  font-style: normal;
}

.nav {
  display: flex;
  gap: 35px;
}

.nav a,
.header-contact {
  font-size: 12px;
  color: rgba(255,255,255,.75);
  transition: color .25s ease;
}

.nav a:hover,
.header-contact:hover {
  color: var(--accent);
}

.header-contact {
  padding: 12px 18px;
  border: 1px solid var(--border);
  border-radius: 4px;
}

.menu-toggle {
  display: none;
  color: var(--text);
  background: transparent;
  border: none;
  font-size: 25px;
  cursor: pointer;
}

.hero {
  min-height: 760px;
  position: relative;
  display: flex;
  align-items: center;
  padding: 150px 8% 100px;
  overflow: hidden;
  background: #20211e;
}

.hero-image {
  position: absolute;
  inset: 0;
  background-image: url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85');
  background-size: cover;
  background-position: center;
  opacity: .55;
  animation: heroZoom 18s ease-in-out infinite alternate;
}

@keyframes heroZoom {
  from { transform: scale(1); }
  to { transform: scale(1.08); }
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(12,13,11,.95) 0%, rgba(12,13,11,.65) 55%, rgba(12,13,11,.2) 100%);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 760px;
}

.eyebrow,
.section-label {
  color: var(--accent);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 3px;
}

.hero h1 {
  margin: 28px 0;
  font-size: clamp(55px, 8vw, 105px);
  line-height: .98;
  letter-spacing: -6px;
  font-weight: 600;
}

.hero h1 span {
  color: var(--accent);
}

.hero-description {
  max-width: 460px;
  color: rgba(255,255,255,.7);
  font-size: 15px;
}

.hero-actions {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
  margin-top: 35px;
}

.button-primary,
.button-secondary {
  display: inline-block;
  padding: 15px 23px;
  font-size: 12px;
  font-weight: 800;
  transition: .3s ease;
}

.button-primary {
  background: var(--accent);
  color: #171511;
}

.button-primary:hover {
  background: #f2a16b;
  transform: translateY(-3px);
}

.button-secondary {
  border: 1px solid rgba(255,255,255,.35);
}

.button-secondary:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.hero-bottom {
  position: absolute;
  z-index: 2;
  bottom: 30px;
  left: 8%;
  right: 8%;
  display: flex;
  justify-content: space-between;
  color: rgba(255,255,255,.5);
  font-size: 9px;
  letter-spacing: 2px;
}

.intro,
.services,
.projects,
.contact {
  padding: 120px 8%;
}

.intro-content {
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  gap: 70px;
  margin-top: 45px;
}

h2 {
  font-size: clamp(38px, 5vw, 64px);
  line-height: 1.08;
  letter-spacing: -3px;
  font-weight: 600;
}

h2 span {
  color: var(--accent);
}

.intro-text {
  padding-top: 8px;
}

.intro-text p,
.contact > p {
  margin-bottom: 20px;
  color: var(--muted);
  font-size: 14px;
}

.text-link {
  display: inline-block;
  margin-top: 12px;
  padding-bottom: 7px;
  border-bottom: 1px solid var(--accent);
  font-size: 12px;
}

.services {
  background: var(--surface);
}

.services > h2 {
  margin-top: 30px;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-top: 55px;
}

.service-card {
  min-height: 250px;
  padding: 27px 22px;
  position: relative;
  background: var(--surface-light);
  border: 1px solid var(--border);
  transition: .3s ease;
}

.service-card:hover {
  transform: translateY(-7px);
  border-color: var(--accent);
}

.service-card > span {
  color: var(--accent);
  font-size: 11px;
}

.service-card h3 {
  margin: 45px 0 12px;
  font-size: 18px;
}

.service-card p {
  color: var(--muted);
  font-size: 12px;
}

.service-card b {
  position: absolute;
  right: 22px;
  bottom: 20px;
  color: var(--accent);
  font-size: 20px;
}

.projects-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-top: 35px;
}

.projects-heading p {
  color: var(--muted);
  font-size: 12px;
}

.project-grid {
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  gap: 25px;
  margin-top: 45px;
}

.project-item {
  min-width: 0;
}

.project-image {
  min-height: 340px;
  position: relative;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  transition: background-size .4s ease;
}

.project-image::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(0deg, rgba(0,0,0,.55), transparent 65%);
}

.project-image-one {
  background-image: url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85');
}

.project-image-two {
  background-image: url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=85');
}

.project-image span {
  position: absolute;
  z-index: 2;
  left: 22px;
  bottom: 20px;
  color: white;
  font-size: 10px;
  letter-spacing: 2px;
}

.project-item h3 {
  margin-top: 20px;
  font-size: 20px;
}

.project-item > p {
  margin-top: 5px;
  color: var(--muted);
  font-size: 12px;
}

.demo-note {
  margin-top: 30px;
  color: var(--muted);
  font-size: 11px;
}

.contact {
  background:
    radial-gradient(circle at 80% 50%, rgba(229,138,82,.1), transparent 35%),
    var(--surface);
}

.contact h2 {
  margin: 35px 0 22px;
}

.contact .button-primary {
  margin-top: 15px;
}

footer {
  padding: 35px 8%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-top: 1px solid var(--border);
}

footer p,
footer > a:last-child {
  color: var(--muted);
  font-size: 11px;
}

@media (max-width: 900px) {
  .service-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .intro-content {
    gap: 35px;
  }
}

@media (max-width: 650px) {
  .header {
    padding: 20px 6%;
  }

  .nav {
    display: none;
    position: absolute;
    top: 75px;
    left: 0;
    right: 0;
    padding: 25px;
    flex-direction: column;
    gap: 20px;
    background: #171815;
  }

  .nav.active {
    display: flex;
  }

  .header-contact {
    display: none;
  }

  .menu-toggle {
    display: block;
  }

  .hero {
    min-height: 700px;
    padding: 140px 7% 100px;
  }

  .hero h1 {
    font-size: 57px;
    letter-spacing: -4px;
  }

  .hero-bottom {
    left: 7%;
    right: 7%;
    font-size: 8px;
  }

  .hero-bottom span:nth-child(2) {
    display: none;
  }

  .intro,
  .services,
  .projects,
  .contact {
    padding: 80px 7%;
  }

  .intro-content,
  .project-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .service-grid {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .service-card {
    min-height: 230px;
    padding: 20px 15px;
  }

  .service-card h3 {
    font-size: 15px;
  }

  .projects-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .project-image {
    min-height: 260px;
  }

  footer {
    padding: 30px 7%;
    flex-wrap: wrap;
  }
}

@media (max-width: 380px) {
  .service-grid {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: 48px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
